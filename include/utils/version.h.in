// xstyle: ignore-file CPP-GUARD-NAME (VERSION_H is the guard of version.hpp)

#ifndef VERSION_C_H
    #define VERSION_C_H

    //----------------------------------------------------------------//
    /* DEFINE */

    // Definition of the library version (set by the cmake)
    #define __LIBUTILS_VERSION__ "@LIBUTILS_VERSION@"

    //----------------------------------------------------------------//
    /* GLOBAL */

// only using native type (no std::string_view in C), no namespace in C: prefixed name (one copy per translation unit)
static const char utils_version[] = __LIBUTILS_VERSION__;

#endif /* VERSION_C_H */
